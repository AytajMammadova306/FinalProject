@{
    int count = (Model.CurrentPage - 1) * 3;
}
@using Cinemastic.Application.ViewModel.Movie
@model GetMovieAdminPageVM

<div class="row">
    <div class="col-sm-12">
        <div class="streamit-wraper-table">
            <div class="card-header d-flex justify-content-between gap-3 flex-wrap align-items-center mb-4">
                <h2 class="episode-playlist-title wp-heading-inline">
                    <span class="position-relative">Movies</span>
                </h2>
                <a class="btn btn-primary" asp-controller="Movie" asp-action="Create">
                    <i class="fa-solid fa-plus me-2"></i>Add Movie
                </a>
            </div>

            <div class="table-view table-space">
                <table id="seasonTable"
                       class="data-tables data-table-one table custom-table movie_table"
                       data-toggle="data-table1">
                    <thead>
                        <tr class="text-uppercase">
                            <th>No</th>
                            <th>Image</th>
                            <th>Title</th>
                            <th>Release Date and Time</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (GetMovieAdminVM movieVM in Model.Movies)
                        {
                            count++;
                            <tr>
                                <td class="py-1">@count</td>
                                <td>
                                    <img src="@movieVM.ImageUrl" alt="image"
                                         class="rounded-2 avatar avatar-55 img-fluid" />
                                </td>
                                <td>@movieVM.Name</td>
                                <td>@movieVM.Date</td>
                                <td>
                                    <div class="d-flex align-items-center list-user-action gap-2">
                                        <a class="btn btn-sm btn-icon btn-success-subtle rounded"
                                           data-bs-toggle="tooltip" data-bs-placement="top" title="Edit"
                                           asp-controller="Movie" asp-action="Edit" asp-route-id="@movieVM.Id">
                                            <i class="ph ph-pencil-simple fs-6"></i>
                                        </a>
                                        <a class="btn btn-sm btn-icon btn-danger-subtle delete-btn rounded"
                                           data-bs-toggle="tooltip" data-bs-placement="top" title="Delete"
                                           href="#">
                                            <i class="ph ph-trash-simple fs-6"></i>
                                        </a>
                                        <a class="btn btn-sm btn-icon btn-info-subtle rounded"
                                           data-bs-toggle="tooltip" data-bs-placement="top" title="View"
                                           href="#">
                                            <i class="ph ph-eye fs-6"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
