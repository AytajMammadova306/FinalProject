        <!-- NAVIGATION SCRIPT FOR FRONTEND LAYOUT - SAME LOGIC -->
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                console.log('=== FRONTEND NAVIGATION START ===');

                // Get current URL path
                const currentPath = window.location.pathname.toLowerCase();
                console.log('Current URL:', currentPath);

                // Remove all active classes first
                document.querySelectorAll('#header-menu .nav-link').forEach(link => {
                    link.classList.remove('active');
                });

                // Collect all links with their hrefs
                const links = [];
                document.querySelectorAll('#header-menu .nav-link').forEach(link => {
                    const href = link.getAttribute('href');
                    if (href && !href.startsWith('#')) {
                        links.push({
                            element: link,
                            href: href.toLowerCase(),
                            length: href.length
                        });
                    }
                });

                // Sort by length (longest first) to match most specific routes first
                links.sort((a, b) => b.length - a.length);

                console.log('Checking links (longest to shortest):');
                let matchFound = false;

                for (const linkData of links) {
                    const link = linkData.element;
                    const href = linkData.href;

                    // EXACT match only - current path must exactly equal the href
                    const isMatch = currentPath === href;

                    const linkText = link.textContent.trim();
                    console.log(`  "${linkText}": ${href} ${isMatch ? '✅ MATCH' : '❌'}`);

                    if (isMatch && !matchFound) {
                        console.log(`  ✅✅✅ ACTIVATING: "${linkText}"`);

                        // Add active class
                        link.classList.add('active');
                        matchFound = true;

                        // If inside a collapsible menu, expand parent
                        const parentCollapse = link.closest('.sub-nav');
                        if (parentCollapse) {
                            console.log('    📂 Expanding parent menu...');
                            parentCollapse.classList.add('show');

                            // Find and activate parent toggle
                            const collapseId = parentCollapse.getAttribute('id');
                            const parentToggle = document.querySelector(`[data-bs-toggle="collapse"][href="#${collapseId}"]`);
                            if (parentToggle) {
                                parentToggle.classList.add('active');
                                parentToggle.setAttribute('aria-expanded', 'true');
                            }
                        }

                        break; // Stop after first match
                    }
                }

                if (!matchFound) {
                    console.warn('❌ No exact match found for:', currentPath);
                } else {
                    console.log('✅ Navigation activated successfully!');
                }

                console.log('=== FRONTEND NAVIGATION END ===');
            });
        </script>
