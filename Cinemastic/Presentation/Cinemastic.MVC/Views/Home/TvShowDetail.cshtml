<div class="modal fade view-more-data-modal trending-info" id="viewMoreDataModal" tabindex="-1" aria-modal="true"
     role="dialog">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header pb-0">
                <h3 class="text-uppercase m-0 texture-text texture-text-modal fw-bold">@Model.TvShowVM.Name</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-1">
                <ul class="list-inline d-flex align-items-center flex-wrap gap-3 mt-4">
                    <li>
                        <span class="fw-medium">@(Model.TvShowVM.ReleaseDate?.ToString("dd MMMM 'of' yyyy"))</span>
                    </li>
                    <li>
                        <span class="badge bg-secondary d-flex align-items-center gap-2 fw-bold font-size-12 movie-type-tag">
                            <span>
                                @Model.TvShowVM.AgeRating
                            </span>
                        </span>
                    </li>
                </ul>

                <div class="d-flex align-items-baseline flex-wrap gap-2 mt-md-1 mt-2">
                    <h6 class="m-0">Genres:</h6>
                    <ul class="p-0 mb-0 list-inline d-flex flex-wrap movie-tag">
                        @foreach (string genre in Model.TvShowVM.Genres)
                        {
                            <li class="trending-list"><a href="./view-all-movie.html">@genre</a></li>
                        }
                    </ul>
                </div>

                @if (Model.TvShowVM.Tags.Count()>=1)
                {
                    <div class="d-flex align-items-baseline flex-wrap gap-2 mt-3">
                        <h6 class="m-0">Tags:</h6>
                        <ul class="iq-blog-meta-cat-tag iq-blogtag mb-0 list-inline d-flex flex-wrap align-items-center gap-1 gap-md-3 mt-2 mt-md-3  tvshow-tags">
                            @foreach (string tag in Model.TvShowVM.Tags)
                            {
                                <li>
                                    <a href=".//blog/blog-tag.html" class="position-relative">@tag</a>
                                </li>
                            }
                        </ul>
                    </div>
                }
                


                <p class="mt-4 mb-0">
                    @Model.TvShowVM.Description
                </p>

                @{
                    int count = 0;
                }

                @if (Model.Starring.Count()>=1)
                {
                    <div class="d-flex align-items-baseline row-gap-1 column-gap-2 mt-4">
                        <h6 class="m-0">Cast:</h6>
                        <ul class="list-inline m-0 p-0 d-flex align-items-center flex-wrap row-gap-1 column-gap-2 cast-crew-list">
                            
                            @foreach (string cast in Model.TvShowVM.Casts)
                            {
                                if (Model.TvShowVM.Casts.Count() > count + 1)
                                {
                                    <li><a href="#" class="color-inherit">@cast,</a></li>
                                    count++;
                                    continue;
                                }
                                <li><a href="#" class="color-inherit">@cast</a></li>
                            }
                        </ul>
                    </div>
                }
                

                @if (Model.Starring.Count()>=1)
                {
                    <div class="d-flex align-items-baseline row-gap-1 column-gap-2 mt-4">
                        <h6 class="m-0">Crew:</h6>
                        <ul class="list-inline m-0 p-0 d-flex align-items-center flex-wrap row-gap-1 column-gap-2 cast-crew-list">
                            @{
                                count = 0;
                            }
                            @foreach (string crew in Model.TvShowVM.Crews)
                            {
                                if (Model.TvShowVM.Crews.Count() > count + 1)
                                {
                                    <li><a href="#" class="color-inherit">@crew,</a></li>
                                    count++;
                                    continue;
                                }
                                <li><a href="#" class="color-inherit">@crew</a></li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
