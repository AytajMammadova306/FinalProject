                <h5 class="main-title text-capitalize mb-0 fw-medium">Episodes</h5>
            </div>
            @{
                bool first = true;
            }
            <ul class="nav nav-pills custom-tab-slider episode-nav-btn gap-3 mb-4 pb-2" role="tablist">
                @foreach (int seasonid in Model.TvShowVM.SeasonIds)
                {
                    <li class="nav-item">
                        <a class="nav-link @(first ? "active show" : "")" data-bs-toggle="pill" href="#season-@seasonid" role="tab"
                           aria-selected="true">
                            Season @seasonid
                        </a>
                    </li>
                    first = false;
                }
            </ul>
            @{
                bool firstContent = true;
            }
            <div class="tab-content">
                @foreach (int seasonid in Model.TvShowVM.SeasonIds)
                {
                    <div id="season-@seasonid" class="tab-pane animated fadeInUp  @(firstContent ? "active show" : "")" role="tabpanel">
                        <div class="card-style-slider">
                            <div class="position-relative swiper swiper-card overflow-hidden" data-slide="5"
                                 data-laptop="5" data-tab="2" data-mobile="2" data-mobile-sm="1" data-autoplay="false"
                                 data-loop="false"
                            >
                                <div class="p-0 swiper-wrapper m-0 list-inline">
                                    @foreach (GetEpisodeItemVM episodeItemVM in Model.TvShowVM.Episodes.Where(e => e.SeasonId ==seasonid))
                                    {
                                        <div class="swiper-slide">
                                            @Html.Partial("EpisodItemPartialView", episodeItemVM)
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    firstContent = false;
                }
                
            </div>
        </div>
