@using Cinemastic.Application.ViewModel.Home
@using Cinemastic.Application.ViewModel.Movie
@using Cinemastic.Domain.Enums
@model AllMoviesVM
<!--bread-crumb-->
<div class="iq-breadcrumb">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-sm-12">
                <nav aria-label="breadcrumb" class="text-center">
                    <ol class="breadcrumb justify-content-center text-white mt-0">
                        <li class="breadcrumb-item"><a asp-controller="home" asp-action="index">Home</a></li>
                        <li class="breadcrumb-item active">View @((Model.Movies.Count > 1) ? "All Movies" : "Movie")</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>  

<!--bread-crumb-->

<div class="section-padding view-all-movies">
    <div class="container-fluid">
        <div class="card-style-grid">
            <div class="btn-group mb-3">
                <form asp-action="allmovies" asp-controller="home" asp-route-page="@Model.CurrentPage" asp-route-take="@Model.Take">
                    <button type="submit" class="btn btn-danger">Sort By</button>
                    <button type="button" class="btn btn-danger dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="visually-hidden">Toggle Dropdown</span>
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            <button type="submit" name="key" value="@((int)SortType.Name)" class="dropdown-item @(Model.Key == (int)SortType.Name ? "active" : "")">
                                Name
                            </button>
                        </li>
                        <li>
                            <button type="submit" name="key" value="@((int)SortType.Date)" class="dropdown-item @(Model.Key == (int)SortType.Date ? "active" : "")">
                                Date
                            </button>
                        </li>
                    </ul>
                </form>
            </div><!-- /btn-group -->

            <div class="row gy-4 row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 data-listing">

                @foreach (GetMovieItemVM movieItemVM in Model.Movies)
                {
                    <div class="col">
                        @Html.Partial("MovieItemPartialView",movieItemVM)
                    </div>
                }
                

            </div>
            <!-- Static Load More -->
            <div class="bd-example mt-5 mb-4">
                <nav aria-label="Standard pagination example">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-controller="home" asp-action="allmovies" asp-route-page="@(Model.CurrentPage - 1)" asp-route-take="@Model.Take"  aria-label="Previous">
                                <span aria-hidden="true">«</span>
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-controller="home" asp-action="allmovies" asp-route-page="@(i)" asp-route-take="@Model.Take">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-controller="home" asp-action="allmovies" asp-route-page="@(Model.CurrentPage + 1)" asp-route-take="@Model.Take" aria-label="Next">
                                <span aria-hidden="true">»</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
<div class="streamit-mobile-footer-menu" aria-label="Mobile Footer Navigation">
    <ul class="footer-menu list-inline d-flex align-items-center justify-content-between m-0">
        <li class="footer-menu-item">
            <a href="./view-all-movie.html" class="menu-link font-size-12">
                <i class="ph ph-film-reel d-block  text-center "></i>
                Movies
            </a>
        </li>
        <li class="footer-menu-item">
            <a href="./view-all-movie.html" class="menu-link font-size-12">
                <i class="ph ph-monitor-play d-block  text-center "></i>
                Videos
            </a>
        </li>
        <li class="footer-menu-item">
            <a href="./view-all-movie.html" class="menu- font-size-12">
                <i class="ph ph-magnifying-glass d-block  text-center "></i>
                Search
            </a>
        </li>
        <li class="footer-menu-item">
            <a href="./view-all-movie.html" class="menu-link font-size-12">
                <i class="ph ph-television d-block  text-center "></i>
                TV Shows
            </a>
        </li>
        <li class="footer-menu-item">
            <a href="./profile-marvin.html" class="menu-link font-size-12">
                <i class="ph ph-user d-block  text-center "></i>
                Profile
            </a>
        </li>
    </ul>
</div>  </main>