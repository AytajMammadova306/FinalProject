<body class=" custom-header-relative ">
    <div class="section-padding vh-100 d-flex align-items-center " style="background-image: url( @Url.Content("~/assets/images/pages/01.webp") ); background-size: cover; background-repeat: no-repeat;">
    <div class="container ">
        <div class="row justify-content-center">
            @foreach (PlanVM planVM in Model.PlanVMs)
            {
                <div class="col-xl-4 col-md-6 mb-3 mb-lg-0">
                    <div class="pricing-plan-wrapper">
                        <div class="pricing-plan-header">
                            <div class="plan-wrapper">
                                <h4 class="plan-name">@planVM.Name</h4>
                            </div>
                            <div class="pricing-plan-details">

                                <span class="plan-main-price">$@planVM.Price</span>

                                <span class="plan-period-time">/ @planVM.Interval</span>
                            </div>
                        </div>
                        <div class="pricing-details">
                            <div class="pricing-plan-description">
                                <ul class="list-inline p-0">
                                    <li> 
                                        @if (planVM.AdFree)
                                        {
                                            <i class="ph ph-check fw-bold"></i>
                                        }
                                        else
                                        {
                                            <i class="ph ph-x fw-bold text-primary"></i>
                                        }
                                        
                                        <span class="font-size-18 fw-500">Ads free movies and shows</span>
                                    </li>
                                    <li>
                                        @if (planVM.TvorLaptop)
                                        {
                                            <i class="ph ph-check fw-bold"></i>
                                        }
                                        else
                                        {
                                            <i class="ph ph-x fw-bold text-primary"></i>
                                        }
                                        <span class="font-size-18 fw-500">Watch on TV or Laptop</span>
                                    </li>
                                    <li>
                                        @if (planVM.MaxQuality)
                                        {
                                            <i class="ph ph-check fw-bold"></i>
                                        }
                                        else
                                        {
                                            <i class="ph ph-x fw-bold text-primary"></i>
                                        }
                                        <span class="font-size-18 fw-500">Max video quality</span>
                                    </li>
                                </ul>
                            </div>
                            <div class="pricing-plan-footer">
                                <div class="iq-button">
                                    <a asp-controller="account" asp-action="register" class="btn btn-primary fw-semibold rounded-3">
                                        Checkout
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
